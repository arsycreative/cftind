# Supabase Configuration
# Dapatkan dari Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Platform Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile CAPTCHA (Opsional, untuk proteksi bot di produksi)
# Dapatkan dari Cloudflare Dashboard > Turnstile
# Kunci Pengujian Cloudflare (Selalu Berhasil):
#   Site Key: 1x00000000000000000000AA
#   Secret Key: 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
